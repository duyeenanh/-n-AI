{
  "name": "moc-mien-flower-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k \"npm:server:dev\" \"npm:dev\"",
    "server:dev": "node --watch server/index.js",
    "server:start": "node server/index.js",
    "db:seed": "node server/seed.js",
    "db:catalog": "node server/seed.js --catalog-only",
    "test": "node --test tests/*.test.js",
    "ai:evaluate": "node scripts/evaluate-ai.js",
    "ai:provider-check": "node scripts/check-ai-provider.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "vite": "^6.0.5"
  }
}
