PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Supabase PostgreSQL connection string (Session/Transaction Pooler or Direct URL)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSL=true

# Optional: Gemini Developer API supports a free tier for eligible models.
# Never put provider keys in frontend code or commit .env.
# Without a key, recommendations use the offline TF-IDF + cosine baseline.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openaiAI_CHAT_MODEL=gemini-3.1-flash-lite
AI_EMBEDDINGS_ENABLED=false
AI_EMBEDDING_MODEL=

# Seed the local administrator. Change the password before any real deployment.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@mocmien.local
ADMIN_PASSWORD=ChangeMe123!

# Optional: create or reset employee accounts when running npm run db:seed.
STAFF_1_NAME=
STAFF_1_EMAIL=
STAFF_1_PASSWORD=
STAFF_2_NAME=
STAFF_2_EMAIL=
STAFF_2_PASSWORD=
STAFF_3_NAME=
STAFF_3_EMAIL=
STAFF_3_PASSWORD=

# Replace with real store payment details before accepting bank transfers.
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
